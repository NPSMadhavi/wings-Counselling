# Copy to apps/api/.env and fill in values.

# Admin auth (email + password — no username)
# ADMIN_EMAIL must match the Microsoft account used for "Continue with Microsoft"
ADMIN_EMAIL=
ADMIN_PASSWORD=
JWT_SECRET=

# Session secret (for Microsoft OAuth state storage)
SESSION_SECRET=

# Microsoft Graph silent email (Client Credentials — NO login button)
# Prefer document names; MS_* aliases also work.
AZURE_CLIENT_ID=
AZURE_TENANT_ID=
AZURE_CLIENT_SECRET=
# Aliases (optional if AZURE_* set):
# MS_CLIENT_ID=
# MS_TENANT_ID=
# MS_CLIENT_SECRET=

MAIL_FROM=
MAIL_TO=

# Legacy aliases if MAIL_FROM / MAIL_TO empty:
ORGANIZATION_EMAIL=
ORGANIZATION_NOTIFICATION_EMAIL=

# PostgreSQL (src/config/db.js)
# DATABASE_URL takes precedence over PG_* vars when set.
DATABASE_URL=postgresql://postgres:your_password@127.0.0.1:5433/Wings
PG_HOST=127.0.0.1
PG_PORT=5433
PG_USER=postgres
PG_PASSWORD=your_password
PG_NAME=Wings
# PostgreSQL 17 (pgAdmin) uses port 5433 on this machine — not 5432 or 5434
# PG_SSL=true
# PG_POOL_MAX=10

# MySQL (existing app routes — src/config/db.js)
# DB_HOST=localhost
# DB_USER=root
# DB_PASSWORD=
# DB_NAME=wings
# DB_PORT=3306

# SMTP
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
SMTP_SECURE=true
EMAIL_FROM=

NODE_ENV=development

# Frontend URL (Microsoft login redirects + unsubscribe email links)
# FRONTEND_URL is also used by Microsoft login for post-login redirects
FRONTEND_URL=http://localhost:5173
CLIENT_URL=http://localhost:5173
SERVER_URL=http://localhost:5001
# SITE_URL=http://localhost:5173
# Origin only — do not include /candidate-portal or other paths.
CANDIDATE_PORTAL_URL=http://localhost:5173

# Production example:
# NODE_ENV=production
# CANDIDATE_PORTAL_URL=https://wings-counselling.org
